# Copy to .env and provide real values. Never commit .env.
MOIRAI_ORIGIN=https://moirai.to
MOIRAI_ADDR=0.0.0.0:8080
MOIRAI_DB_DRIVER=pgx
DATABASE_URL=postgres://moirai:CHANGE_ME@postgres:5432/moirai?sslmode=disable
POSTGRES_PASSWORD=CHANGE_ME
# openssl rand -hex 32; retain this key securely with your recovery material.
MOIRAI_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MOIRAI_SUPPORT_EMAIL=
# Optional: exact trusted reverse-proxy address CIDRs, comma-separated.
# Empty ignores X-Forwarded-For. Configure the actual proxy peer, not all networks.
MOIRAI_TRUSTED_PROXY_CIDRS=
# Optional private Prometheus scrape credential, at least 32 characters.
MOIRAI_METRICS_TOKEN=
# Private bucket; hostname only, without https://.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
